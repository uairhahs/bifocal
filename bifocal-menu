#!/bin/bash
# bifocal-menu: layout picker for bifocal, meant for a keyboard shortcut
#
# The picker is bifocal-menu.qml, run with Qt's qml tool. Running bifocal-menu
# again while the picker is open does not open a second one: it counts one more
# press, and the open picker moves its highlight down a row (wrapping), like
# KDE's own Meta+P display switcher. Enter or a click applies the highlighted
# layout; Escape or clicking elsewhere closes the picker.

HERE="$(dirname "$(readlink -f "$0")")"
BIFOCAL="${HERE}/bifocal"
MENU_QML="${HERE}/bifocal-menu.qml"

RUNTIME_DIR="${XDG_RUNTIME_DIR:-/tmp}/bifocal-${UID}"
LOCK_FILE="${RUNTIME_DIR}/menu.lock"
PRESS_DIR="${RUNTIME_DIR}/presses"

if [[ ! -d ${RUNTIME_DIR} ]]; then
	mkdir -m 700 "${RUNTIME_DIR}" || exit 1
fi

# The open picker holds this lock for as long as it is on screen
exec 9>"${LOCK_FILE}"
if ! flock -n 9; then
	mkdir -p "${PRESS_DIR}"
	mktemp -p "${PRESS_DIR}" press.XXXXXX >/dev/null
	exit 0
fi

rm -rf "${PRESS_DIR}"
mkdir -p "${PRESS_DIR}"

# The qml tool on PATH may be the Qt 5 one, so look for Qt 6's by name first
QML=""
for candidate in qml6 /usr/lib/qt6/bin/qml /usr/lib64/qt6/bin/qml; do
	if command -v "${candidate}" >/dev/null 2>&1; then
		QML="${candidate}"
		break
	fi
done
if [[ -z ${QML} ]]; then
	notify-send "Bifocal" "Could not find Qt 6's qml tool (qml6)." -i display-error -a "System"
	exit 1
fi

"${QML}" "${MENU_QML}" -- "${PRESS_DIR}"
CHOICE=$?

# Release the lock before switching, which takes a few seconds
exec 9>&-
rm -rf "${PRESS_DIR}"

# --- Switching Logic ---
case "${CHOICE}" in
10) exec "${BIFOCAL}" internal ;;
11) exec "${BIFOCAL}" external ;;
12) exec "${BIFOCAL}" extended ;;
*) exit 0 ;;
esac
