#!/bin/bash
# bifocal-menu: wofi (or rofi) picker for bifocal, meant for a keyboard shortcut

BIFOCAL="$(dirname "$(readlink -f "$0")")/bifocal"

# --- Icons & Options ---
CH_LAPTOP="󰌢    Laptop Only"
CH_EXTERNAL="󰍹    External Only"
CH_BOTH="󰹑    Extend Both"
OPTIONS="${CH_LAPTOP}\n${CH_EXTERNAL}\n${CH_BOTH}"
FONT="GeistMono Nerd Font"

# --- Palette ---
BG="#1E1E2E"
SURFACE="#2A2A3C"
SURFACE_HOVER="#38384D"
FG="#D9E0EE"
ACCENT="#c678dd"
ON_ACCENT="#11111B"

# --- Wofi Configuration ---
CONFIG_FILE=$(mktemp --suffix=wofi.conf)
STYLE_FILE=$(mktemp --suffix=wofi.css)
# Throwaway cache: wofi sorts by usage count, which would reorder the options over time
CACHE_FILE=$(mktemp --suffix=wofi.cache)
trap 'rm -f "${CONFIG_FILE}" "${STYLE_FILE}" "${CACHE_FILE}"' EXIT

cat >"${CONFIG_FILE}" <<WOFI
show=dmenu
width=480
lines=3
location=center
close_on_focus_loss=true
allow_images=false
hide_scroll=true
cache_file=${CACHE_FILE}
prompt=""
WOFI

cat >"${STYLE_FILE}" <<WOFI
/* The window stays transparent so the rounded corners of #outer-box show the desktop */
window {
    background-color: transparent;
    font-family: "${FONT}";
}

#outer-box {
    margin: 24px;
    padding: 14px;
    border-radius: 28px;
    border: 1px solid rgba(198, 120, 221, 0.35);
    background-color: ${BG};
    box-shadow: 0 8px 20px rgba(0, 0, 0, 0.45);
}

#scroll, #inner-box {
    background-color: transparent;
    border: none;
}

/* #entry is the flowboxchild itself */
#entry {
    margin: 4px 0;
    padding: 16px 22px;
    border-radius: 18px;
    outline: none;
    box-shadow: none;
    background-color: ${SURFACE};
    transition: background-color 120ms ease;
}

#entry:hover {
    background-color: ${SURFACE_HOVER};
}

#entry:selected {
    background-color: ${ACCENT};
}

#entry #text {
    color: ${FG};
    font-weight: 600;
}

/* :selected propagates to children, so the GTK theme's "*:selected" rule would
   otherwise paint its own background behind the label */
#entry:selected * {
    background: transparent;
}

#entry:selected #text {
    color: ${ON_ACCENT};
}
WOFI

# --- Execution ---
if command -v wofi >/dev/null 2>&1; then
	CHOICE=$(echo -e "${OPTIONS}" | wofi --conf "${CONFIG_FILE}" --style "${STYLE_FILE}" --hide-search --no-custom-entry --insensitive)
else
	CHOICE=$(echo -e "${OPTIONS}" | rofi -dmenu -i -p "󰒓  Layout")
fi

# --- Switching Logic ---
case "${CHOICE}" in
*"Laptop Only"*) "${BIFOCAL}" internal ;;
*"External Only"*) "${BIFOCAL}" external ;;
*"Extend Both"*) "${BIFOCAL}" extended ;;
*) exit 0 ;;
esac
